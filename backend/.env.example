PORT=5000
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000

# Opsi 1: Database Lokal (PostgreSQL di Laragon / Localhost)
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dprd_db

# Opsi 2: Cloud Database (Neon / Supabase)
# Jika DATABASE_URL diisi, Opsi 1 otomatis di-override
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/dprd_db?sslmode=require

JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=7d
RESET_TTL_MINUTES=15
QR_TTL_MINUTES=60
